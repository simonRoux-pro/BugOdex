# Clé API Google Gemini — 100% gratuite, sans carte bancaire (tier gratuit :
# 1500 requêtes/jour). Va sur aistudio.google.com → "Get API key" → "Create API key".
# C'est la même clé que celle utilisée par BugOdex, si tu en as déjà une.
GOOGLE_AI_KEY=AIza...

# Aucune autre clé n'est nécessaire : la recherche de source (Project Gutenberg,
# Internet Archive) et les couvertures (Open Library) utilisent des API publiques
# gratuites sans authentification.
